<!DOCTYPE html>
<html lang="my">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🪔 Happy Thadingyut 🪔</title>
    <style>
        body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #1a1a2e;
            color: #ffffff;
            font-family: sans-serif;
            text-align: center;
            margin: 0;
            overflow: hidden;
        }
        h1 {
            color: #ffcc00;
            font-size: 19px;
            margin-bottom: 30px;
            padding: 0 20px;
            line-height: 1.6;
        }
        .buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            width: 100%;
            height: 60px;
        }
        button {
            padding: 12px 22px;
            font-size: 16px;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
        }
        .primary-btn {
            background-color: #ff9900;
            color: #1a1a2e;
        }
        .run-btn {
            background-color: #4a4e69;
            color: white;
        }
    </style>
</head>
<body>

    <h1 id="text">🪔 ကလေးမလေးအတွက် သီတင်းကျွတ်ဆုတောင်းလေးရှိတယ်နော်... <br><br> ဒါပေမဲ့ မေးခွန်းလေးတေအရင်ဖြေရမယ်နော် 😜</h1>
    
    <!-- အဆင့် ၀ -->
    <div class="buttons" id="btnGroup0">
        <button class="primary-btn" onclick="step1()">ဖြေမယ် ✨</button>
    </div>

    <!-- အဆင့် ၁ -->
    <div class="buttons" id="btnGroup1" style="display: none;">
        <button id="yesBtn" class="primary-btn" onclick="step2()">လွမ်းတယ်🥺</button>
        <button id="noBtn" class="run-btn" onclick="moveButton(event, 'noBtn')" ontouchstart="moveButton(event, 'noBtn')">လွမ်းပါဘူး😕</button>
    </div>

    <!-- အဆင့် ၂ -->
    <div class="buttons" id="btnGroup2" style="display: none;">
        <button class="primary-btn" onclick="step3()">ဆက်ကြည့်ပါ🙄</button>
    </div>

    <!-- အဆင့် ၃ -->
    <div class="buttons" id="btnGroup3" style="display: none;">
        <button class="primary-btn" onclick="step4()">ကြည့်မယ် ✨</button>
        <button id="noLookBtn" class="run-btn" onclick="moveButton(event, 'noLookBtn')" ontouchstart="moveButton(event, 'noLookBtn')">မကြည့်ဘူး 😜</button>
    </div>

    <script>
        function moveButton(event, btnId) {
            if (event) {
                event.stopPropagation();
                event.preventDefault();
            }

            let btn = document.getElementById(btnId);
            btn.style.position = "fixed";

            let maxX = window.innerWidth - btn.offsetWidth - 20;
            let maxY = window.innerHeight - btn.offsetHeight - 20;

            let x = Math.max(20, Math.floor(Math.random() * maxX));
            let y = Math.max(20, Math.floor(Math.random() * maxY));

            btn.style.left = x + "px";
            btn.style.top = y + "px";
        }

        function step1() {
            document.getElementById("text").innerHTML = "အကို့ကိုလွမ်းနေတာမလား? 😜";
            document.getElementById("btnGroup0").style.display = "none";
            document.getElementById("btnGroup1").style.display = "flex";
        }

        function step2() {
            document.getElementById("text").innerHTML = "အကိုလဲလွမ်းပါတယ်နော် 💗";
            document.getElementById("btnGroup1").style.display = "none";
            document.getElementById("btnGroup2").style.display = "flex";
            
            let noBtn = document.getElementById("noBtn");
            if (noBtn) noBtn.style.display = "none";
        }

        function step3() {
            document.getElementById("text").innerHTML = "နောက်ဆုံးတခုကျန်သေးတယ်...";
            document.getElementById("btnGroup2").style.display = "none";
            document.getElementById("btnGroup3").style.display = "flex";
        }

        function step4() {
            document.getElementById("text").innerHTML = "အပျိုကြီးပဲလုပ်ပါနော် 😜✨<br><br>🪔 လာမဲ့သီတင်းကျွတ်မှာ ပျော်ရွှင်ပါစေနော်! <br><br> ရောက်ရှိရာအရပ်မှာနွေးထွေးတဲ့ဆက်ဆံရေးတေနဲ့ဆုံရပီးအေးချမ်းသောဘဝလေးကိုပိုင်ဆိုင်ရပါစေနော် 💗";
            document.getElementById("btnGroup3").style.display = "none";
            
            let noLookBtn = document.getElementById("noLookBtn");
            if (noLookBtn) noLookBtn.style.display = "none";
        }
    </script>

</body>
</html>
